<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.clawmast.clawmastd</string>

    <key>ProgramArguments</key>
    <array>
        <string>@@CLAWMASTD_BIN@@</string>
        <string>-install-root</string>
        <string>@@CLAWMAST_HOME@@</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>CLAWMAST_HOME</key>
        <string>@@CLAWMAST_HOME@@</string>
        <!-- launchd strips PATH to /usr/bin:/bin:/usr/sbin:/sbin, which
             hides Homebrew (/opt/homebrew/bin, /usr/local/bin) and every
             per-user Node toolchain. The worker's openclaw discovery
             falls back to bare filesystem probes when LookPath misses,
             but a broader PATH here lets the fast path (LookPath) win
             for the common brew + ~/.local/bin layouts without extra
             stat calls. -->
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:@@HOME_LOCAL_BIN@@:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <!-- RunAtLoad starts clawmastd on user login. KeepAlive ensures
         launchd restarts it if clawmastd itself ever exits with a
         non-zero status; supervisor-protocol.md §6.3 reserves exit
         64 for "do not restart" which launchd respects via
         SuccessfulExit. -->
    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <key>ThrottleInterval</key>
    <integer>5</integer>

    <key>StandardOutPath</key>
    <string>@@LOG_DIR@@/clawmastd.out.log</string>
    <key>StandardErrorPath</key>
    <string>@@LOG_DIR@@/clawmastd.err.log</string>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
